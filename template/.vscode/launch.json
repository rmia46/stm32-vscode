{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32 (F5)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/OLED.elf",
            "device": "STM32F103C8",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f1x.cfg"
            ],
            "armToolchainPath": "/home/roman/.local/share/stm32cube/bundles/gnu-gdb-for-stm32/14.3.1+st.2/bin",
            "runToEntryPoint": "main",
            "preLaunchTask": "Build",
            "overrideLaunchCommands": [
                "monitor reset halt",
                "load",
                "tbreak main",
                "continue"
            ]
        }
    ]
}
