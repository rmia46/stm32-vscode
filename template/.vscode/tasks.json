{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "ninja -C ${workspaceFolder}/build/Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Flash Device (Build & Flash)",
            "type": "shell",
            "command": "openocd -f interface/stlink.cfg -c 'reset_config none' -f target/stm32f1x.cfg -c 'init; halt; program ${workspaceFolder}/build/Debug/OLED.elf verify reset exit'",
            "dependsOn": "Build",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
